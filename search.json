---
layout: null
---
[
{% for article in site.articles %}
  {
    "title": {{ article.title | jsonify }},
    "excerpt": {{ article.excerpt | default: "" | strip_html | jsonify }},
    "author": {{ article.author | default: "" | jsonify }},
    "category": {{ article.category | default: "" | jsonify }},
    "tags": {{ article.tags | default: empty | jsonify }},
    "content": {{ article.content | strip_html | strip_newlines | jsonify }},
    "url": {{ article.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
